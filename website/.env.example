# ===== INSTAMOJO PAYMENT GATEWAY =====
# Test mode: https://test.instamojo.com/api/1.1
# Production: https://www.instamojo.com/api/1.1
NEXT_PUBLIC_INSTAMOJO_API_KEY=your_api_key_here
INSTAMOJO_AUTH_TOKEN=your_auth_token_here
INSTAMOJO_API_URL=https://test.instamojo.com/api/1.1/

# Base URL (for payment redirects)
NEXT_PUBLIC_BASE_URL=https://ukpscdecoded.com

# ===== GOOGLE SHEETS =====
# Publish your Google Sheet: File > Share > Publish to web > CSV
# Then paste the Sheet ID from the URL
NEXT_PUBLIC_CURRENT_AFFAIRS_SHEET_ID=your_sheet_id
NEXT_PUBLIC_PYQ_SHEET_ID=your_sheet_id

# ===== YOUTUBE API =====
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key

# ===== DECAP CMS — GITHUB OAUTH =====
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL:               https://your-site.vercel.app
#   Authorization callback URL: https://your-site.vercel.app/api/callback
# Then paste the Client ID and generated Client Secret below.
GITHUB_OAUTH_ID=your_github_oauth_client_id
GITHUB_OAUTH_SECRET=your_github_oauth_client_secret

# ===== SITE CONFIGURATION =====
NEXT_PUBLIC_SITE_URL=https://ukpscdecoded.com
NEXT_PUBLIC_YOUTUBE_CHANNEL=https://youtube.com/@UKPSCDecoded
NEXT_PUBLIC_TELEGRAM_CHANNEL=https://t.me/ukpscdecoded

# ===== TEST PLATFORM: SUPABASE =====
# Project → Settings → API. See supabase/schema.sql for the tables this code expects.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== TEST PLATFORM: SESSION SIGNING =====
# Any long random string (e.g. `openssl rand -hex 32`). Signs student login
# session cookies. Changing this logs everyone out.
SESSION_SECRET=generate_a_long_random_string

# ===== TEST PLATFORM: ADMIN QUESTION IMPORT =====
# Any long random string. Required in the x-admin-secret header for
# /api/admin/import-questions, and entered on the admin unlock screen.
ADMIN_IMPORT_SECRET=generate_a_long_random_string

# ===== TEST PLATFORM: PASSWORD RESET EMAIL (RESEND) =====
# https://resend.com/api-keys — the sending domain (send.ukpscdecoded.in)
# must be verified in the Resend dashboard first.
RESEND_API_KEY=your_resend_api_key

# ===== TEST PLATFORM: PACKAGE STORE PAYMENTS (RAZORPAY TEST MODE) =====
# https://dashboard.razorpay.com/app/keys — use TEST mode keys, not live.
RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret
# Dashboard → Settings → Webhooks → add https://<your-domain>/api/payments/webhook
# for the payment.captured event (test mode), then paste the secret shown there.
# Razorpay can't reach localhost, so this only works once deployed.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret

# Kill switch: must be exactly "true" for create-order to accept
# purchases; the Buy button shows "Sales open soon" otherwise. Keep this
# unset or "false" on production until you actually want to sell.
PAYMENTS_ENABLED=false

# ===== TEST PLATFORM: DAILY BACKUP CRON =====
# Any long random string. Vercel sends it as "Authorization: Bearer
# <value>" automatically when triggering the cron in vercel.json — must
# match exactly, or every request (including real cron triggers) is
# rejected. Runs daily at 18:30 UTC (00:00 IST).
CRON_SECRET=generate_a_long_random_string
